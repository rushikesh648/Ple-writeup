apache.org/licenses/\n","\"\"\", encoding=\"utf-8\")\n","\n","# 3. Recreate None-Safe harness.py if missing\n","harness_path = WORKSPACE / \"harness.py\"\n","if not harness_path.is_file():\n","    harness_path.write_text('''#!/usr/bin/env python3\n","import os, json, re, asyncio\n","from typing import List, Set, Dict, Any, Optional\n","from openai import AsyncOpenAI\n","\n","try:\n","    import taskbridge\n","except ImportError:\n","    taskbridge = None\n","\n","client = AsyncOpenAI(\n","    base_url=os.environ.get(\"OPENAI_BASE_URL\", \"https://generativelanguage.googleapis.com/v1beta/openai/\"),\n","    api_key=os.environ.get(\"OPENAI_API_KEY\", \"dummy-key\"),\n",")\n","MODEL_NAME = os.environ.get(\"MODEL_NAME\", \"gemini-2.5-pro\")\n","\n","EMERGENCY_TIME_THRESHOLD_SEC = 180\n","MAX_AGENT_STEPS = 35\n","MAX_TOOL_OUTPUT_CHARS = 16000\n","\n","SYSTEM_PROMPT = \"\"\"You are a Principal Physical and Systems Engineer.\n","1. Inspect the workspace directory first.\n","2. Identify governing codes (AISC, ASCE, IEEE, ASME, ACI) and unit system (SI vs US Customary).\n","3. Write self-contained Python scripts to verify calculations and safety margins (C/D >= 1.0).\n","4. Write out the exact requested deliverable files (.csv, .json, .dxf, .xlsx, .txt) before finishing.\"\"\"\n","\n","TOOLS_SPEC = [\n","    {\"type\": \"function\", \"function\": {\"name\": \"bash_exec\", \"description\": \"Execute bash command.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"command\": {\"type\": \"string\"}}, \"required\": [\"command\"]}}},\n","    {\"type\": \"function\", \"function\": {\"name\": \"read_file\", \"description\": \"Read file contents.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}}, \"required\": [\"path\"]}}},\n","    {\"type\": \"function\", \"function\": {\"name\": \"write_file\", \"description\": \"Write deliverable file.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}},\n","]\n","\n","def safe_str(val: Any) -> str:\n","    return \"\" if val is None else str(val)\n","\n","def extract_expected_deliverables(task_instruction: Optional[str]) -> Set[str]:\n","    text = safe_str(task_instruction)\n","    matches = re.findall(r'\\\\b([a-zA-Z0-9_\\\\-]+\\\\.(?:csv|dxf|json|xlsx|pdf|txt|step|ifc))\\\\b', text, re.IGNORECASE)\n","    excluded = {\"submission.yaml\", \"manifest.json\", \"requirements.txt\", \"taskbridge.py\"}\n","    return {m for m in matches if m.lower() not in excluded}\n","\n","async def verify_deliverables_on_disk(session: Any, expected_files: Set[str]) -> List[str]:\n","    missing = []\n","    for fname in expected_files:\n","        try:\n","            res = await session.exec(f\"test -s '{fname}' && echo 'EXISTS' || echo 'MISSING'\", timeout_sec=15)\n","            if \"EXISTS\" not in safe_str(getattr(res, \"output\", \"\")):\n","                missing.append(fname)\n","        except Exception:\n","            missing.append(fname)\n","    return missing\n","\n","async def emergency_fallback_write(session: Any, missing_files: List[str], task_instruction: str, summary: str) -> None:\n","    session.log(f\"EMERGENCY PROTOCOL: Generating missing deliverables {missing_files}\")\n","    prompt = f\"DEADLINE WARNING. Generate valid JSON mapping missing filenames {missing_files} to string content for objective: {task_instruction}\\\\nContext:\\\\n{summary[-3500:]}\"\n","    try:\n","        res = await client.chat.completions.create(\n","            model=MODEL_NAME,\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            temperature=0.0,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        msg = getattr(res.choices[0], \"message\", None) if getattr(res, \"choices\", None) else None\n","        content_dict = json.loads(safe_str(getattr(msg, \"content\", \"{}\")) or \"{}\")\n",