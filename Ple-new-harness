xt\n","\n","            if t_file.suffix == \".json\":\n","                try:\n","                    payload = json.loads(raw_text)\n","                    is_passed = payload.get(\"passed\", False) or payload.get(\"status\") == \"success\"\n","                    error_details = payload.get(\"error\") or payload.get(\"failure_reason\") or raw_text\n","                except Exception:\n","                    pass\n","            else:\n","                is_passed = \"PASSED\" in raw_text and \"FAILED\" not in raw_text\n","\n","            if is_passed:\n","                passed_count += 1\n","            else:\n","                failed_count += 1\n","                cat = classify_error(str(error_details))\n","                first_err_line = str(error_details).strip().splitlines()[-1][:120]\n","                classified_results[cat].append((task_id, first_err_line))\n","\n","    total = passed_count + failed_count\n","    pass_rate = (passed_count / total * 100) if total > 0 else 0.0\n","\n","    print(f\"Task Evaluation Summary: {passed_count}/{total} Passed ({pass_rate:.1f}% Pass Rate)\")\n","    print(\"=\" * 65)\n","\n","    print(\"\\nRoot Cause Breakdown for Failed Tasks:\")\n","    for cat, items in classified_results.items():\n","        if items:\n","            print(f\"\\n[{len(items)}] {cat}:\")\n","            for tid, snippet in items:\n","                print(f\"   • {tid}: {snippet}\")\n","\n","    # Generate breakdown frequencies suitable for Kaggle Writeup Figure 3\n","    print(\"\\n\" + \"=\" * 65)\n","    print(\"Frequency Array for Matplotlib (Figure 3 data):\")\n","    labels = [k.split(\"(\")[0].strip() for k in FAILURE_CATEGORIES.keys()]\n","    counts = [len(classified_results[k]) for k in FAILURE_CATEGORIES.keys()]\n","    print(f\"categories = {labels}\")\n","    print(f\"failure_counts = {counts}\")\n","\n","\n","if __name__ == \"__main__\":\n","    run_diagnostics()"]},{"cell_type":"code","execution_count":11,"id":"cb235e43","