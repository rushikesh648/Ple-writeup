[\n","        r\"no such file or directory\",\n","        r\"deliverable.*missing\",\n","        r\"file not found\",\n","        r\"expected artifact.*not found\",\n","        r\"missing required output\",\n","        r\"empty deliverable\",\n","    ],\n","    \"Unit Drift & Dimensional Inconsistency\": [\n","        r\"unit.*mismatch\",\n","        r\"dimensional.*inconsisten\",\n","        r\"incompatible units\",\n","        r\"pint\\.errors\",\n","        r\"conversion error\",\n","        r\"expected.*kn.*got.*kips\",\n","        r\"expected.*psi.*got.*mpa\",\n","    ],\n","    \"CAD / BIM Spatial Parse Error\": [\n","        r\"ezdxf\",\n","        r\"ifcopenshell\",\n","        r\"dxf.*invalid\",\n","        r\"entity.*not found\",\n","        r\"block.*not found\",\n","        r\"coordinate.*out of bounds\",\n","        r\"cad.*parsing\",\n","    ],\n","    \"Regulatory Code / Factor-of-Safety Violation\": [\n","        r\"safety factor\",\n","        r\"c/d ratio\",\n","        r\"demand exceeds capacity\",\n","        r\"allowable stress exceeded\",\n","        r\"asce\",\n","        r\"aisc\",\n","        r\"aci 318\",\n","        r\"ieee\",\n","        r\"asme\",\n","        r\"code check failed\",\n","    ],\n","    \"Subprocess / Solver Timeout\": [\n","        r\"timeout\",\n","        r\"timed out\",\n","        r\"exceeded \\d+s\",\n","        r\"solver.*did not converge\",\n","        r\"maximum execution time\",\n","    ],\n","    \"Python Execution / Syntax Exception\": [\n","        r\"traceback\",\n","        r\"syntaxerror\",\n","        r\"nameerror\",\n","        r\"typeerror\",\n","        r\"indexerror\",\n","        r\"importerror\",\n","        r\"modulenotfounderror\",\n","    ],\n","}\n","\n","\n","def find_eval_dir() -> Path:\n","    for path in LOG_PATHS:\n","        if path.is_dir():\n","            return path\n","    return Path(\".\")\n","\n","\n","def classify_error(log_text: str) -> str:\n","    log_lower = log_text.lower()\n","    for category, patterns in FAILURE_CATEGORIES.items():\n","        for pat in patterns:\n","            if re.search(pat, log_lower):\n","                return category\n","    return \"Unclassified / Numerical Tolerance Error\"\n","\n","\n","def run_diagnostics():\n","    eval_dir = find_eval_dir()\n","    print(f\"Scanning evaluation directory: {eval_dir.resolve()}\\n\" + \"=\" * 65)\n","\n","    task_files = sorted(list(eval_dir.glob(\"task_*.json\")) + list(eval_dir.glob(\"*.log\")))\n","    summary_file = eval_dir / \"summary.json\"\n","\n","    classified_results = {cat: [] for cat in FAILURE_CATEGORIES}\n","    classified_results[\"Unclassified / Numerical Tolerance Error\"] = []\n","    \n","    passed_count = 0\n","    failed_count = 0\n","\n","    # Branch 1: Parse summary.json if available\n","    if summary_file.is_file():\n","        try:\n","            with open(summary_file, \"r\", encoding=\"utf-8\") as f:\n","                data = json.load(f)\n","            tasks = data.get(\"tasks\", {})\n","            for task_id, res in tasks.items():\n","                if res.get(\"passed\", False) or res.get(\"status\") == \"success\":\n","                    passed_count += 1\n","                else:\n","                    failed_count += 1\n","                    err_msg = json.dumps(res)\n","                    cat = classify_error(err_msg)\n","                    classified_results[cat].append((task_id, res.get(\"error\", \"Failed evaluation criteria\")))\n","        except Exception as e:\n","            print(f\"Notice: Failed parsing summary.json ({e}), falling back to task logs.\")\n","\n","    # Branch 2: Fallback to individual task files if summary had no tasks\n","    if passed_count == 0 and failed_count == 0:\n","        for t_file in task_files:\n","            task_id = t_file.stem\n","            raw_text = t_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n","\n","            is_passed = False\n","            error_details = raw_text\n","\n","            if t_file.suffix == \".json\":\n","                try:\n","                    payload = json.loads(raw_text)\n","                    is_passed = payload.get(\"passed\", False) or payload.get(\"status\") == \"success\"\n","                    error_details = payload.get(\"error\") or payload.get(\"failure_reason\") or raw_text\n","                except Exception:\n","                    pass\n","            else:\n","                is_passed = \"PASSED\" in raw_text and \"FAILED\" not in raw_text\n","\n","            if is_passed:\n","                passed_count += 1\n","            else:\n","                failed_count += 1\n","                cat = classify_error(str(error_details))\n","                first_err_line = str(error_details).strip().splitlines()[-1][:120]\n","                classified_results[cat].append((task_id, first_err_line))\n","\n","    total = passed_count + failed_count\n","    pass_rate = (passed_count / total * 100) if total > 0 else 0.0\n","\n","    print(f\"Task Evaluation Summary: {passed_count}/{total} Passed ({pass_rate:.1f}% Pass Rate)\")\n","    print(\"=\" * 65)\n","\n","    print(\"\\nRoot Cause Breakdown for Failed Tasks:\")\n","    for cat, items in classified_results.items():\n","        if items:\n","            print(f\"\\n[{len(items)}] {cat}:\")\n","            for tid, snippet in items:\n","                print(f\"   • {tid}: {snippet}\")\n","\n","    # Generate breakdown frequencies suitable for Kaggle Writeup Figure 3\n","    print(\"\\n\" + \"=\" * 65)\n","    print(\"Frequency Array for Matplotlib (Figure 3 data):\")\n","    labels = [k.split(\"(\")[0].strip() for k in FAILURE_CATEGORIES.keys()]\n","    counts = [len(classified_results[k]) for k in FAILURE_CATEGORIES.keys()]\n","    print(f\"categories = {labels}\")\n","    print(f\"failure_counts = {counts}\")\n","\n","\n","if __name__ == \"__main__\":\n","    run_diagnostics()"]},{"cell_type":"code","execution_count":11,"id":"e10