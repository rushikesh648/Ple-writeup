pacity-to-demand ratios (C/D >= 1.0).\n","4. COMPLETE THE ARTIFACT: A script execution log is NOT a deliverable. You MUST write out the exact final target files (e.g., .csv, .dxf, .json, .xlsx) requested in the prompt.\n","\"\"\"\n","\n","TOOLS_SPEC = [\n","    {\n","        \"type\": \"function\",\n","        \"function\": {\n","            \"name\": \"bash_exec\",\n","            \"description\": \"Execute a bash shell command in the task container (max 90s).\",\n","            \"parameters\": {\n","                \"type\": \"object\",\n","                \"properties\": {\n","                    \"command\": {\"type\": \"string\", \"description\": \"The command line string\"}\n","                },\n","                \"required\": [\"command\"],\n","            },\n","        },\n","    },\n","    {\n","        \"type\": \"function\",\n","        \"function\": {\n","            \"name\": \"read_file\",\n","            \"description\": \"Read file contents (text/code) from the task directory.\",\n","            \"parameters\": {\n","                \"type\": \"object\",\n","                \"properties\": {\n","                    \"path\": {\"type\": \"string\", \"description\": \"Relative file path\"}\n","                },\n","                \"required\": [\"path\"],\n","            },\n","        },\n","    },\n","    {\n","        \"type\": \"function\",\n","        \"function\": {\n","            \"name\": \"write_file\",\n","            \"description\": \"Write or overwrite deliverables and solver scripts in the task directory.\",\n","            \"parameters\": {\n","                \"type\": \"object\",\n","                \"properties\": {\n","                    \"path\": {\"type\": \"string\", \"description\": \"Relative file path\"},\n","                    \"content\": {\"type\": \"string\", \"description\": \"Full file content\"}\n","                },\n","                \"required\": [\"path\", \"content\"],\n","            },\n","        },\n","    },\n","]\n","\n","\n","def safe_str(val: Any) -> str:\n","    \"\"\"Safely converts any value to string, defaulting None to empty string.\"\"\"\n","    return \"\" if val is None else str(val)\n","\n","\n","def extract_expected_deliverables(task_instruction: Optional[str]) -> Set[str]:\n","    \"\"\"Extracts explicit file names mentioned in the prompt (e.g. results.csv, layout.dxf).\"\"\"\n","    text = safe_str(task_instruction)\n","    pattern = r'\\b([a-zA-Z0-9_\\-]+\\.(?:csv|dxf|json|xlsx|pdf|txt|step|ifc))\\b'\n","    matches = re.findall(pattern, text, re.IGNORECASE)\n","    excluded = {\"submission.yaml\", \"manifest.json\", \"requirements.txt\", \"taskbridge.py\"}\n","    return {m for m in matches if m.lower() not in excluded}\n","\n","\n","async def verify_deliverables_on_disk(session: Any, expected_files: Set[str]) -> List[str]:\n","    \"\"\"Checks if expected deliverables exist and are non-empty in the session workdir.\"\"\"\n","    missing_files: List[str] = []\n","    for filename in expected_files:\n","        check_cmd = f\"test -s '{filename}' && echo 'EXISTS' || echo 'MISSING'\"\n","        try:\n","            res = await session.exec(check_cmd, timeout_sec=15)\n","            out = safe_str(getattr(res, \"output\", \"\"))\n","            if \"EXISTS\" not in out:\n","                missing_files.append(filename)\n","        except Exception:\n","            missing_files.append(filename)\n","    return missing_files\n","\n","\n","async def emergency_fallback_write(\n","    session: Any,\n","    missing_files: List[str],\n","    task_instruction: Optional[str],\n","    conversation_summary: Optional[str]\n",") -> None:\n","    \"\"\"Emergency zero-tool fallback invoked when time runs out with missing deliverables.\"\"\"\n","    session.log(f\"EMERGENCY PROTOCOL ENGAGED: Direct generation fallback for {missing_files}\")\n","    \n","    prompt = f\"\"\"CRITICAL DEADLINE WARNING: The task deadline is expiring in under 2 minutes.\n","The following mandatory output files are missing or empty on disk:\n","{missing_files}\n","\n","Original Objective:\n","{safe_str(task_instruction)}\n","\n","Work done so far:\n","{safe_str(conversation_summary)[-4000:]}\n","\n","For each missing file, generate a viable, mathematically compliant deliverable now.\n","Output in valid JSON format mapping filename to string content:\n","{{\n","  \"filename.csv\": \"col1,col2\\\\nval1,val2\"\n","}}\n","\"\"\"\n","    try:\n","        response = await client.chat.completions.create(\n","            model=MODEL_NAME,\n","            messages=[{\"role\": \"user\", \"content\": prompt}],\n","            temperature=0.0,\n","            response_format={\"type\": \"json_object\"}\n","        )\n","        if not response or not getattr(response, \"choices\", None):\n","            return\n","\n","        choice = response.choices[0]\n","        msg = getattr(choice, \"message\", None)\n","        if not msg:\n","            return\n","\n","        raw_json = safe_str(getattr(msg, \"content\", \"{}\"))\n","        content_dict = json.loads(raw_json or \"{}\")\n","\n","        if isinstance(content_dict, dict):\n","            for fname, content in content_dict.items():\n","                if fname in missing_files and content is not None:\n","                    c_str = safe_str(content)\n","                    await session.write_file(fname, c_str)\n","                    session.log(f\"Emergency write successful: {fname} ({len(c_str)} bytes)\")\n","    except Exception as e:\n","        session.log(f\"Emergency generation fallback error: {str(e)}\")\n","\n","\n","async def solve_task(session: Any) -> str:\n","    \"\"\"Core entrypoint called per task WebSocket connection.\"\"\"\n","    task_instruction = safe_str(getattr(session, \"instruction\", \"\"))\n","    workdir = safe_str(getattr(session, \"workdir\", \".\"))\n","    \n","    expected_files = extract_expected_deliverables(task_instruction)\n","    session.log(f\"Starting hid