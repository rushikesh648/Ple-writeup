ategory, patterns in FAILURE_CATEGORIES.items():\n","        for pat in patterns:\n","            if re.search(pat, log_lower):\n","                return category\n","    return \"Unclassified / Numerical Tolerance Error\"\n","\n","\n","def run_diagnostics():\n","    eval_dir = find_eval_dir()\n","    print(f\"Scanning evaluation directory: {eval_dir.resolve()}\\n\" + \"=\" * 65)\n","\n","    task_files = sorted(list(eval_dir.glob(\"task_*.json\")) + list(eval_dir.glob(\"*.log\")))\n","    summary_file = eval_dir / \"summary.json\"\n","\n","    classified_results = {cat: [] for cat in FAILURE_CATEGORIES}\n","    classified_results[\"Unclassified / Numerical Tolerance Error\"] = []\n","    \n","    passed_count = 0\n","    failed_count = 0\n","\n","    # Branch 1: Parse summary.json if available\n","    if summary_file.is_file():\n","        try:\n","            with open(summary_file, \"r\", encoding=\"utf-8\") as f:\n","                data = json.load(f)\n","            tasks = data.get(\"tasks\", {})\n","            for task_id, res in tasks.items():\n","                if res.get(\"passed\", False) or res.get(\"status\") == \"success\":\n","                    passed_count += 1\n","                else:\n","                    failed_count += 1\n","                    err_msg = json.dumps(res)\n","                    cat = classify_error(err_msg)\n","                    classified_results[cat].append((task_id, res.get(\"error\", \"Failed evaluation criteria\")))\n","        except Exception as e:\n","            print(f\"Notice: Failed parsing summary.json ({e}), falling back to task logs.\")\n","\n","    # Branch 2: Fallback to individual task files if summary had no tasks\n","    if passed_count == 0 and failed_count == 0:\n","        for t_file in task_files:\n","            task_id = t_file.stem\n","            raw_text = t_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n","\n","            is_passed = False\n","            error_details = raw_text\