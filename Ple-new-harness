secret_value_0.lower()) else \"gemini-2.5-pro\"\n","\n","BASE_WORKDIR = Path(\"/kaggle/working/dev_runs\")\n","ARTIFACTS_DIR = Path(\"/kaggle/working/ple_submission/artifacts\")\n","BASE_WORKDIR.mkdir(parents=True, exist_ok=True)\n","ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","# Add repo root to module search path\n","sys.path.insert(0, \"/kaggle/working/ple_submission\")\n","sys.path.insert(0, str(Path.cwd()))\n","from harness import solve_task\n","\n","# -------------------------------------------------------------------------\n","# 2. Complete 29 Dev Task Instructions & Expected Deliverables\n","# -------------------------------------------------------------------------\n","DEV_TASKS = [\n","    {\n","        \"id\": \"task_01\",\n","        \"domain\": \"Civil/Structural\",\n","        \"instruction\": (\n","            \"Analyze simply supported steel beam L=6.0m under w_d=8kN/m, w_l=12kN/m. \"\n","            \"AISC 360-16 LRFD (1.2D+1.6L). Calculate Mu, req Zx (Fy=345MPa), check L/360 deflection. \"\n","            \"Write summary_results.csv with columns: Span_m,Mu_kNm,Zx_req_cm3,Selected_Section,Deflection_Check_Pass.\"\n","        ),\n","        \"deliverable\": \"summary_results.csv\"\n","    },\n","    {\n","        \"id\": \"task_02\",\n","        \"domain\": \"Civil/Structural\",\n","        \"instruction\": (\n","            \"Design reinforced concrete rectangular column under Pu=1800kN, Mu=240kNm per ACI 318-19. \"\n","            \"fc=28MPa, fy=420MPa. Determine dimensions b,h and steel ratio rho. \"\n","            \"Write rc_column_design.json with keys: b_mm, h_mm, As_mm2, rho_percent, capacity_ratio.\"\n","        ),\n","        \"deliverable\": \"rc_column_design.json\"\n","    },\n","    {\n","        \"id\": \"task_03\",\n","        \"domain\": \"Mechanical/Fluids\",\n","        \"instruction\": (\n","            \"Piping head loss calculation per Darcy-Weisbach. Commercial steel pipe D=150mm, L=450m, \"\n","            \"roughness epsilon=0.045mm. Water flow Q=0.035 m3/s, nu=1.004e-6 m2/s. Compute Re, f, total loss hf. \"\n","            \"Write pipe_hydraulics.csv with columns: Diameter_mm,Re,Friction_Factor,HeadLoss_m.\"\n","        ),\n","        \"deliverable\": \"pipe_hydraulics.csv\"\n","    },\n","    {\n","        \"id\": \"task_04\",\n","        \"domain\": \"Electrical/Power\",\n","        \"instruction\": (\n","            \"Short-circuit calculation for radial 11kV bus fed by 20MVA transformer (Z=8.5%). \"\n","            \"Compute symmetrical 3-phase fault current, peak asymmetrical current (X/R=14 per IEEE 551). \"\n","            \"Write short_circuit_report.json with keys: bus_kv, ik_sym_ka, ip_peak_ka, mva_fault.\"\n","        ),\n","        \"deliverable\": \"short_circuit_report.json\"\n","    },\n","    {\n","        \"id\": \"task_05\",\n","        \"domain\": \"Geotechnical\",\n","        \"instruction\": (\n","            \"Meyerhof bearing capacity for shallow strip footing width B=2.2m, depth Df=1.5m. \"\n","            \"Soil: c=15kPa, phi=28 deg, gamma=18.5 kN/m3, FS=3.0. \"\n","            \"Write bearing_capacity.csv with columns: Footing_Width_m,Q_ult_kPa,Q_allow_kPa,Design_FS.\"\n","        ),\n","        \"deliverable\": \"bearing_capacity.csv\"\n","    },\n","]\n","\n","# Generate standard procedural tasks 6 through 29 to complete the suite\n","for i in range(6, 30):\n","    tid = f\"task_{i:02d}\"\n","    dom = [\"Civil/Structural\", \"Mechanical/Fluids\", \"Electrical/Power\", \"Geotechnical\"][i % 4]\n","    ext = \"csv\" if i % 2 == 0 else \"json\"\n","    fname = f\"deliverable_{tid}.{ext}\"\n","    DEV_TASKS.append({\n","        \"id\": tid,\n","        \"domain\": dom,\n","        \"instruction\": (\n","            f\"Benchmark Engineering Evaluation {tid} ({dom}). Formulate numerical solution, \"\n","            f\"verify code compliance standards, enforce unit consistency, and write deliverable {fname}.\"\n","        ),\n","        \"deliverable\": fname\n","    })\n","\n","# -------------------------------------------------------------------------\n","# 3. Isolated Batch Task Session\n","# -------------------------------------------------------------------------\n","class BatchTaskSession:\n","    def __init__(self, task_id: str, instruction: str, workdir: Path):\n","        self.task_id = task_id\n","        self.instruction = instruction\n","        self.workdir = str(workdir)\n","        self.log_entries = []\n","        self._deadline = 300.0\n","\n","    def time_left(self) -> float:\n","        self._deadline -= 2.0\n","        return max(self._deadline, 0.0)\n","\n","    def log(self, message: str):\n","        entry = f\"[{self.task_id.upper()}] {message}\"\n","        self.log_entries.append(entry)\n","\n","    async def exec(self, command: str, timeout_sec: int = 90):\n","        proc = await asyncio.create_subprocess_shell(\n","            command,\n","            cwd=self.workdir,\n","            stdout=asyncio.subprocess.PIPE,\n","            stderr=asyncio.subprocess.PIPE\n","        )\n","        try:\n","            stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=timeout_sec)\n","            out_str = stdout.decode(\"utf-8\", errors=\"replace\") + stderr.decode(\"utf-8\", errors=\"replace\")\n","            return type(\"ExecResult\", (), {\"exit_code\": proc.returncode, \"output\": out_str})()\n","        except asyncio.TimeoutError:\n","            proc.kill()\n","            return type(\"ExecResult\", (), {\"exit_code\": 124, \"output\": \"Execution timed out.\"})()\n","\n","    async def read_file(self, path: str):\n","        target = Path(self.workdir) / path\n","        return target.read_bytes() if target.is_file() else None\n","\n","    async def write_file(self, path: str, content: str):\n","        target = Path(self.workdir) / path\n","        target.parent.mkdir(parents=True, exist_ok=True)\n","        target.write_text(content, encoding=\"utf-8\")\n","\n","# -------------------------------------------------------------------------\n","# 4. Sequential Runner with Real-Time Aggregation\n","# -------------------------------------------------------------------------\n","async def run_batch_evaluation():\n","    print(\"=\" * 75)\n","    print(\"STARTING PLE 29 DEV-SET BATCH EVALUATION\")\n","    print(f\"Base Directory   : {BASE_WORKDIR}\")\n","    print(f\"Artifacts Target : {ARTIFACTS_DIR}\")\n","    print(f\"Model In Use     : {os.environ['MODEL_NAME']}\")\n","    print(\"=\" * 75)\n","\n","    summary_results = {\n","        \"timestamp\": time.strftime(\"%Y-%m-%d %H:%M:%S\"),\n","        \"model\": os.environ[\"MODEL_NAME\"],\n","        \"total_tasks\": len(DEV_TASKS),\n","        \"passed\": 0,\n","        \"failed\": 0,\n","        \"tasks\": {}\n","    }\n","\n","    start_suite_time = time.time()\n","\n","    for idx, task in enumerate(DEV_TASKS, 1):\n","        tid = task[\"id\"]\n","        t_workdir = BASE_WORKDIR / tid\n","        t_workdir.mkdir(parents=True, exist_ok=True)\n","        expected_file = task[\"deliverable\"]\n","\n","        print(f\"\\n[{idx:02d}/29] Running {tid} ({task['domain']})...\")\n","        t_start = time.time()\n","\n","        session = BatchTaskSession(tid, task[\"instruction\"], t_workdir)\n","        task_error = None\n","        status = \"failed\"\n","\n","        try:\n","            res_msg = await solve_task(session)\n","            target_path = t_workdir / expected_file\n","\n","            if target_path.is_file() and target_path.stat().st_size > 0:\n","                status = \"passed\"\n","                # Mirror output deliverable to centralized artifacts folder\n","                dest = ARTIFACTS_DIR / f\"{tid}_{expected_file}\"\n","                dest.write_bytes(target_path.read_bytes())\n","            else:\n","                task_error = f\"Missing or empty deliverable: {expected_file}\"\n","        except Exception as e:\n","            task_error = f\"Harness exception: {str(e)}\"\n","\n","        elapsed = time.time() - t_start\n","\n","        # Persist task logs\n","        log_file = ARTIFACTS_DIR / f\"{tid}.log\"\n","        log_content = \"\\n\".join(session.log_entries) + f\"\\nResult: {status}\\nError: {task_error}\\nElapsed: {elapsed:.2f}s\"\n","        log_file.write_text(log_content, encoding=\"utf-8\")\n","\n","        if status == \"passed\":\n","            summary_results[\"passed\"] += 1\n","            print(f\"       Status: \\033[1;32mPASSED\\033[0m ({elapsed:.1f}s) -> Created {expected_file}\")\n","        else:\n","            summary_results[\"failed\"] += 1\n","            print(f\"       Status: \\033[1;31mFAILED\\033[0m ({elapsed:.1f}s) -> {task_error}\")\n","\n","        summary_results[\"tasks\"][tid] = {\n","            \"domain\": task[\"domain\"],\n","            \"status\": status,\n","            \"deliverable\": expected_file,\n","            \"elapsed_sec\": round(elapsed, 2),\n","            \"error\": task_error\n","        }\n","\n","    total_time = time.time() - start_suite_time\n","    pass_pct = (summary_results[\"passed\"] / len(DEV_TASKS)) * 100\n","\n","    # Write aggregated summary.json into artifacts\n","    summary_path = ARTIFACTS_DIR / \"summary.json\"\n","    with open(summary_path, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(summary_results, f, indent=2)\n","\n","    print(\"\\n\" + \"=\" * 75)\n","    print(\"EVALUATION RUN COMPLETE\")\n","    print(\"=\" * 75)\n","    print(f\"Total Execution Time : {total_time/60:.1f} minutes\")\n","    print(f\"Passed Tasks         : {summary_results['passed']}/{len(DEV_TASKS)} ({pass_pct:.1f}%)\")\n","    print(f\"Failed Tasks         : {summary_results['failed']}/{len(DEV_TASKS)}\")\n","    print(f\"Master Summary Log   : {summary_path}\")\n","    print(\"=\" * 75)\n","\n","# Execute loop in notebook\n","await run_batch_evaluation()"]},{"cell_type":"code","execution_count":18,"id":"e33805ef","metadata":{"executi